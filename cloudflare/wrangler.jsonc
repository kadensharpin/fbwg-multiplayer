{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "multiplayer-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-03",
  "migrations": [
    {
      "new_classes": ["RoomDurableObject"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RoomDurableObject",
        "name": "ROOM_DURABLE_OBJECT"
      }
    ]
  },
  "assets": {
    "directory": "../dist/",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
