{
  "compilerOptions": {
    "rootDir": "./src",
    "outFile": "./dist/lib.js",

    "module": "amd",
    "ignoreDeprecations": "6.0",
    "target": "esnext",
    "types": [],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    // "verbatimModuleSyntax": true,
    // "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "typeRoots": ["./types"]
  }
}
